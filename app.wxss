/* ==================== 按钮工具类 ==================== */
button {
  border-radius: 10rpx;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.btn {
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  border-radius: 5rpx;
  border: none;
}

.btn-primary {
  background-color: #1aad19;
  color: #ffffff;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
}

.btn-disabled {
  background-color: #cccccc;
  color: #ffffff;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #ffffff;
}

.btn-success {
  background-color: #52c41a;
  color: #ffffff;
}

/* ==================== 图标工具类 ==================== */
.icon-sm {
  width: 24rpx;
  height: 24rpx;
}

.icon-md {
  width: 32rpx;
  height: 32rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.icon-lg {
  width: 50rpx;
  height: 50rpx;
}

/* ==================== 显示/隐藏工具类 ==================== */
.show {
  display: block;
}

.hide {
  display: none;
}

/* ==================== 卡片和阴影工具类 ==================== */
.card {
  background: white;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card-shadow {
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* ==================== 状态工具类 ==================== */
.status-normal {
  background-color: #52c41a;
  color: white;
}

.status-warning {
  background-color: #faad14;
  color: white;
}

.status-danger {
  background-color: #ff4d4f;
  color: white;
}

.status-offline {
  background-color: #9b9b9b;
  color: white;
}

/* ==================== 特殊工具类 ==================== */
.longword {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hover {
  background-color: #f0f0f0;
}

.button-container {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.button-container-white {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==================== 角标工具类 ==================== */
.badge {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  min-width: 40rpx;
  height: 40rpx;
  background-color: #ff4d4f;
  color: white;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  z-index: 1;
}

.badge.is-gray {
  background-color: #9b9b9b;
}

/* ==================== 渐变背景工具类 ==================== */
.gradient-bg {
  background: linear-gradient(135deg, #1aad19 0%, #2dd22b 100%);
}

/* ==================== 固定定位工具类 ==================== */
.fixed-bottom {
  position: fixed;
  bottom: 0;
  width: 100%;
}

.fixed-top {
  position: fixed;
  top: 0;
  width: 100%;
}

/* ==================== 弹窗工具类 ==================== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  padding: 0 40rpx;
  backdrop-filter: blur(4rpx);
  animation: fadeIn 0.3s ease-out;
}

.overlay.show {
  display: flex;
}

.popup {
  width: 100%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  position: relative;
  animation: slideUp 0.3s ease-out;
  max-height: 80vh;
}

.popup::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
} 
