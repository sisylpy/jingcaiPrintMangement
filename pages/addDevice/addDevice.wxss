/* pages/addDevice/addDevice.wxss */

/* 页面容器样式 */
.container {
  padding-top: 0;
  min-height: 100vh;
  padding-left: 0;
  padding-right: 0;
}

/* 内容区域样式，为导航栏留出空间 */
.card {
  margin: 20rpx;
  padding: 30rpx;
}

/* 表单项间距 */
.form-item {
  margin: 40rpx 0;
}

/* 表单输入框样式 */
.form-input {
  width: 90%;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  font-size: 32rpx;
  border: none;
  box-sizing: border-box;
  margin-top: 15rpx;
}

/* 只读输入框样式 */
.form-input-readonly {
  background-color: #f0f0f0;
  color: #666;
}

/* 禁用输入框样式 */
.form-input-disabled {
  background-color: #f5f5f5 !important;
  color: #999 !important;
  cursor: not-allowed;
}

/* 单选框样式 */
.radio-group {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.radio {
  display: flex;
  align-items: center;
  padding: 15rpx 30rpx 15rpx 0;
  font-size: 32rpx;
  color: #333;
}

.radio radio {
  margin-right: 10rpx;
}

