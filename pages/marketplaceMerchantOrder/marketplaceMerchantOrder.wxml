<view class="page"><view wx:if="{{loading}}" class="empty">加载中…</view><block wx:else><view class="summary"><view class="status">{{order.fulfillmentStatus}}</view><view>档口子单 {{order.merchantOrderNo}}</view><view class="master">居民总单 {{order.orderNo}}</view></view><view class="card"><view wx:for="{{order.lines}}" wx:key="orderLineId" class="line"><view><view class="goods">{{item.goodsName}}</view><view class="spec">{{item.specification}} · {{item.quantity}}{{item.saleUnit}}</view></view><view>¥{{item.lineAmount}}</view></view><view class="total">本档口合计 ¥{{order.totalAmount}}</view></view><view class="actions"><button wx:for="{{buttons}}" wx:key="code" data-code="{{item.code}}" bindtap="transition" class="{{item.code==='CANCELLED'?'cancel':''}}">{{item.text}}</button></view></block></view>
