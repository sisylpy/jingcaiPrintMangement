.page{min-height:100vh;background:#f3f6f4;padding:24rpx}.summary{background:linear-gradient(145deg,#b6ef82,#77d3a9);border-radius:22rpx;padding:30rpx;color:#173a31}.status{font-size:38rpx;font-weight:800}.master{font-size:22rpx;margin-top:10rpx}.card{background:#fff;border-radius:20rpx;padding:24rpx;margin-top:20rpx}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #edf0ee}.goods{font-weight:800}.spec{color:#89938f;font-size:22rpx;margin-top:7rpx}.total{text-align:right;font-weight:800;padding-top:20rpx}.actions{display:flex;gap:16rpx;margin-top:24rpx}.actions button{flex:1;background:#098e6b;color:#fff}.actions button.cancel{background:#fff;color:#ad4d40;border:1rpx solid #e6b7af}.empty{text-align:center;padding:100rpx;color:#89938f}
