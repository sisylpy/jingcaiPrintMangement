<!--pages/distributer-management/distributer-management.wxml-->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索配送商名称、负责人或电话"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <!-- 配送商列表 -->
  <view class="distributer-list">
    <view 
      class="distributer-card"
      wx:for="{{filteredList}}"
      wx:key="nxDistributerId"
    >
      <!-- 配送商头部信息 -->
      <view class="distributer-header">
        <view class="distributer-info">
          <text class="distributer-name">{{item.nxDistributerShowName}}</text>
          <text class="distributer-type">{{getDistributerTypeText(item.nxDistributerType)}}</text>
        </view>
        <view class="distributer-id">
          <text class="font-xs text-tertiary">ID: {{item.nxDistributerId}}</text>
        </view>
      </view>

      <!-- 配送商详细信息 -->
      <view class="distributer-details">
        <view class="detail-row">
          <text class="detail-label">全称:</text>
          <text class="detail-value">{{item.nxDistributerName}}</text>
        </view>
        
        <view class="detail-row">
          <text class="detail-label">剩余点数:</text>
          <text class="detail-value">{{item.nxDistributerBuyQuantity}}</text>
        </view>
        
        <view class="detail-row">
          <text class="detail-label">联系电话:</text>
          <text 
            class="detail-value phone-link"
            bindtap="makePhoneCall"
            data-phone="{{item.nxDistributerPhone}}"
          >{{item.nxDistributerPhone}}
          </text>
        </view>
        
        <view class="detail-row">
          <text class="detail-label">地址:</text>
          <text class="detail-value">{{item.nxDistributerAddress}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="distributer-actions">
        <view class="action-btn primary" bindtap="viewDistributerDetail" data-id="{{item.nxDistributerId}}">
          <text class="font-sm">打印详情</text>
        </view>
        <view class="action-btn secondary" bindtap="toPayList" data-id="{{item.nxDistributerId}}">
          <text class="font-sm">充值记录</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{filteredList.length === 0 && !loading}}" class="empty-state">
      <view class="empty-icon">📦</view>
      <view class="empty-text">
        {{searchKeyword ? '未找到相关配送商' : '暂无配送商信息'}}
      </view>
      <view wx:if="{{searchKeyword}}" class="empty-tip">
        <text class="font-xs text-tertiary">尝试其他关键词搜索</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="font-md text-secondary">加载中...</text>
  </view>
</view>
