/* 美化按钮样式 */
.reg-btn-container {
  margin: 40rpx 0;
  padding: 0 20rpx;
}

.reg-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.reg-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.reg-btn.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.reg-btn.success {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(79, 172, 254, 0.3);
}

.reg-btn.success:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.4);
}

.reg-btn.disabled {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}

.reg-btn.disabled:active {
  transform: none;
}

/* 调试按钮样式 */
.debug-container {
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.debug-btn {
  width: 100%;
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border: 1px solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.debug-btn:active {
  background: #e8e8e8;
}

/* 头像预览样式优化 */
.avatar-preview-wrap {
  margin: 30rpx 0;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.avatar-preview-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #f5f5f5;
  object-fit: cover;
  border: 3rpx solid #e0e0e0;
}

/* 调试信息样式 */
.debug-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.debug-info text {
  display: block;
  color: #666;
  line-height: 1.4;
}

/* 角色选择器样式 */
.role-picker-container {
  border-radius: 10rpx;
  border: 1px solid #d9d9d9;
  background: white;
  overflow: hidden;
}

.role-picker {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  transition: all 0.3s ease;
}

.role-picker:active {
  background: linear-gradient(135deg, #e9ecef 0%, #f8f9fa 100%);
}

.role-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.role-arrow {
  font-size: 24rpx;
  color: #666;
  transition: transform 0.3s ease;
}

.role-picker:active .role-arrow {
  transform: rotate(180deg);
}

/* 弹窗动画样式 */
.overlay {
  animation: fadeIn 0.3s ease-out;
  display: flex !important;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
}

.overlay.hide {
  display: none !important;
}

.popup {
  animation: slideUp 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
