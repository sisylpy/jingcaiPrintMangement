.login-page{min-height:100vh;background:linear-gradient(160deg,#dff8ef,#f5f7f6);padding:130rpx 34rpx;box-sizing:border-box}.login-card{background:#fff;border-radius:28rpx;padding:42rpx;box-shadow:0 10rpx 36rpx rgba(17,64,51,.09)}.title{font-size:42rpx;font-weight:800;color:#123b31}.sub{font-size:23rpx;color:#7d8984;line-height:1.6;margin:14rpx 0 34rpx}.login-card input{height:86rpx;border:1rpx solid #d8e3df;border-radius:14rpx;padding:0 22rpx;margin:18rpx 0}.login-card button{background:#079b75;color:#fff;margin-top:30rpx;border-radius:42rpx;font-weight:700}
