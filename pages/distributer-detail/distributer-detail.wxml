<!--pages/distributer-detail/distributer-detail.wxml-->
<view class="container">
  <view wx:if="{{distributerInfo}}" class="detail-content">
    <!-- 配送商基本信息 -->
    <view class="card mb-20">
      <view class="card-header">
        <text class="font-lg font-bold text-primary">基本信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">配送商ID</text>
          <text class="info-value">{{distributerInfo.nxDistributerId}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">显示名称</text>
          <text class="info-value">{{distributerInfo.nxDistributerShowName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">全称</text>
          <text class="info-value">{{distributerInfo.nxDistributerName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">配送类型</text>
          <text class="info-value">{{getDistributerTypeText(distributerInfo.nxDistributerType)}}</text>
        </view>
      </view>
    </view>

    <!-- 联系信息 -->
    <view class="card mb-20">
      <view class="card-header">
        <text class="font-lg font-bold text-primary">联系信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">负责人</text>
          <text class="info-value">{{distributerInfo.nxDistributerManager}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">联系电话</text>
          <text class="info-value phone-link" bindtap="makePhoneCall">{{distributerInfo.nxDistributerPhone}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">配送地址</text>
          <text class="info-value address-text">{{distributerInfo.nxDistributerAddress}}</text>
        </view>
      </view>
    </view>

    <!-- 市场信息 -->
    <view class="card mb-20">
      <view class="card-header">
        <text class="font-lg font-bold text-primary">市场信息</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="info-label">所属市场</text>
          <text class="info-value">市场ID: {{distributerInfo.nxDistributerSysMarketId}}</text>
        </view>
        <view class="info-row" wx:if="{{distributerInfo.nxDistributerSysCityId}}">
          <text class="info-label">所属城市</text>
          <text class="info-value">城市ID: {{distributerInfo.nxDistributerSysCityId}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <view class="action-btn primary" bindtap="makePhoneCall">
        <text class="btn-icon">📞</text>
        <text class="btn-text">拨打电话</text>
      </view>
      <view class="action-btn secondary" bindtap="copyAddress">
        <text class="btn-icon">📍</text>
        <text class="btn-text">复制地址</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text class="font-md text-secondary">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:if="{{!distributerInfo && !loading}}" class="error-state">
    <view class="error-icon">❌</view>
    <view class="error-text">加载失败</view>
    <view class="error-tip">请检查网络连接后重试</view>
  </view>
</view>
