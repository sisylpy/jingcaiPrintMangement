<!--pages/user-management/user-management.wxml-->
<view class="container p-20">
  <!-- 分享邀请按钮 -->
  <button class="invite-user-btn" open-type="share">
    <text class="font-md text-white">📤 分享邀请</text>
  </button>

  <!-- 用户列表 -->
  <view wx:if="{{userList.length > 0}}">
    <view class="card p-20 mt-10 mb-10" wx:for="{{userList}}" wx:key="userId">
      <view class="flex-column">
        <view class="flex-row">
          <view class="user-avatar mr-20">
            <image src="{{url + item.avatar}}" mode="aspectFill" class="user-avatar"/>
          </view>
          
          <view class="flex-column ">
            <view class="flex-row">
            <text class="font-md font-bold text-primary mb-5">{{item.nickname}}</text>
            <text class="font-xs text-secondary">{{item.phone || '未绑定手机'}}</text>
          </view>

          <view class="flex-row ">
          <!-- 状态标签和角色标签 -->
          <view class="flex-row align-center">
            <view class="status-tag {{item.status === -1 ? 'pending' : (item.status === 1 ? 'active' : 'disabled')}}">
              {{item.status === -1 ? '待审核' : (item.status === 1 ? '已启用' : '已禁用')}}
            </view>
            
            <view class="role-tag {{item.role === 2 ? 'admin' : 'user'}}">
              {{item.roleText || (item.role === 2 ? '市场主管' : '普通管理员')}}
            </view>
          </view>

        <!-- 操作按钮单独一行 -->
        <view class="action-buttons">
          <!-- 待审核状态：显示开通和拒绝按钮（仅市场主管可见） -->
          <button wx:if="{{item.status === -1 && currentUserRole === 2}}" class="btn-approve" size="mini" bindtap="approveUser" data-user="{{item}}">开通</button>
          <button wx:if="{{item.status === -1 && currentUserRole === 2}}" class="btn-disable" size="mini" bindtap="disableUser" data-user="{{item}}">拒绝</button>
          
          <!-- 已启用状态：显示修改和禁用按钮（仅市场主管可见） -->
          <button wx:if="{{item.status === 1 && currentUserRole === 2}}" class="btn-edit" size="mini" bindtap="goToEditPage" data-user="{{item}}">修改</button>
          <button wx:if="{{item.status === 1 && currentUserRole === 2}}" class="btn-disable" size="mini" bindtap="disableUser" data-user="{{item}}">禁用</button>
          
          <!-- 已禁用状态：显示重新开通按钮（仅市场主管可见） -->
          <button wx:if="{{item.status === 0 && currentUserRole === 2}}" class="btn-approve" size="mini" bindtap="approveUser" data-user="{{item}}">重新开通</button>
          
          <!-- 普通管理员或没有权限时显示提示 -->
          <view wx:if="{{currentUserRole !== 2}}" class="no-permission-tip">
            <text class="permission-text">仅市场主管可操作</text>
          </view>
        </view>

        </view>

          </view>
          



        </view>
        
        
       
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="flex-column-center" style="padding: 100rpx 0;">
    <text class="font-xl mb-20">👥</text>
    <text class="font-sm text-tertiary">暂无用户</text>
  </view>
</view>


