/* pages/user-management/user-management.wxss */

/* 邀请用户按钮 */
.invite-user-btn {
  background-color: #1aad19;
  color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  text-align: center;
  margin: 20rpx 0;
}

/* 用户头像 */
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #1aad19;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

/* 角色标签 */
.role-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  margin-right: 20rpx;
}

.role-tag.admin {
  background-color: #ff4d4f;
}

.role-tag.user {
  background-color: #52c41a;
}

/* 删除按钮 */
.btn-delete {
  background-color: #ff4d4f;
  color: white;
}


/* 状态标签样式 */
.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 10rpx;
}

.status-tag.pending {
  background-color: #fff3cd;
  color: #856404;
  border: 1rpx solid #ffeaa7;
}

.status-tag.active {
  background-color: #d4edda;
  color: #155724;
  border: 1rpx solid #c3e6cb;
}

.status-tag.disabled {
  background-color: #f8d7da;
  color: #721c24;
  border: 1rpx solid #f5c6cb;
}

/* 用户信息行容器 */
.user-info-row {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-top: 15rpx;
}

/* 操作按钮容器 */
.action-buttons {
  display: flex;
  gap: 12rpx;
  justify-content: flex-start;
  margin-top: 15rpx;
  flex-wrap: wrap;
}

/* 开通按钮样式 */
.btn-approve {
  background-color: #28a745 !important;
  color: white !important;
  border: none !important;
  border-radius: 8rpx !important;
  font-size: 28rpx !important;
  padding: 16rpx 24rpx !important;
  line-height: 1 !important;
  font-weight: 500 !important;
  box-shadow: 0 2rpx 8rpx rgba(40, 167, 69, 0.3) !important;
  transition: all 0.3s ease !important;
  min-width: 120rpx !important;
  flex-shrink: 0 !important;
}

.btn-approve::after {
  border: none !important;
}

.btn-approve:active {
  background-color: #1e7e34 !important;
  transform: translateY(1rpx) !important;
  box-shadow: 0 1rpx 4rpx rgba(40, 167, 69, 0.4) !important;
}

.btn-disable {
  background-color: #dc3545 !important;
  color: white !important;
  border: none !important;
  border-radius: 6rpx !important;
  font-size: 24rpx !important;
  padding: 8rpx 16rpx !important;
  line-height: 1 !important;
}

.btn-disable::after {
  border: none !important;
}

/* 修改按钮样式 */
.btn-edit {
  background-color: #007bff !important;
  color: white !important;
  border: none !important;
  border-radius: 8rpx !important;
  font-size: 28rpx !important;
  padding: 16rpx 24rpx !important;
  line-height: 1 !important;
  font-weight: 500 !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 123, 255, 0.3) !important;
  transition: all 0.3s ease !important;
  min-width: 120rpx !important;
  flex-shrink: 0 !important;
}

.btn-edit::after {
  border: none !important;
}

.btn-edit:active {
  background-color: #0056b3 !important;
  transform: translateY(1rpx) !important;
  box-shadow: 0 1rpx 4rpx rgba(0, 123, 255, 0.4) !important;
}

/* 禁用按钮样式优化 */
.btn-disable {
  background-color: #dc3545 !important;
  color: white !important;
  border: none !important;
  border-radius: 8rpx !important;
  font-size: 28rpx !important;
  padding: 16rpx 24rpx !important;
  line-height: 1 !important;
  font-weight: 500 !important;
  box-shadow: 0 2rpx 8rpx rgba(220, 53, 69, 0.3) !important;
  transition: all 0.3s ease !important;
  min-width: 120rpx !important;
  flex-shrink: 0 !important;
}

.btn-disable:active {
  background-color: #c82333 !important;
  transform: translateY(1rpx) !important;
  box-shadow: 0 1rpx 4rpx rgba(220, 53, 69, 0.4) !important;
}

/* 权限提示样式 */
.no-permission-tip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #e9ecef;
}

.permission-text {
  font-size: 24rpx;
  color: #6c757d;
  font-style: italic;
}

.modal-footer button {
  margin-left: 20rpx;
  min-width: 120rpx;
}
