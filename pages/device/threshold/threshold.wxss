/* pages/threshold/threshold.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 页面标题 */
.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 提示框 */
.tip-box {
  display: flex;
  background-color: #e6f7ff;
  border: 1rpx solid #91d5ff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0050b3;
  margin-bottom: 10rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #096dd9;
  line-height: 36rpx;
}

/* 阈值卡片列表 */
.threshold-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.threshold-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.level-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.enable-switch {
  transform: scale(0.9);
}

/* 阈值输入 */
.threshold-input-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 15rpx;
}

.threshold-input {
  flex: 0 0 150rpx;
  height: 70rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  background-color: #fafafa;
}

.threshold-input[disabled] {
  color: #ccc;
  background-color: #f5f5f5;
}

.input-unit {
  font-size: 28rpx;
  color: #666;
  margin-left: 15rpx;
}

/* 消息文本 */
.message-text {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 15rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.message-text.disabled {
  color: #ccc;
}

/* 推荐值按钮 */
.recommend-box {
  margin-top: 20rpx;
  text-align: center;
}

.btn-recommend {
  width: 300rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #fff;
  border: 2rpx solid #1890ff;
  border-radius: 35rpx;
  color: #1890ff;
  font-size: 28rpx;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.btn-save {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-save[disabled] {
  background-color: #d9d9d9;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}

