/* pages/deviceManager/deviceManager.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 设备信息区域 */
.device-info {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  color: white;
}

.device-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.device-no {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 责任人列表 */
.manager-list {
  padding: 20rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title .count {
  font-size: 28rpx;
  color: #999;
  margin-left: 10rpx;
  font-weight: normal;
}

.manager-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

/* 责任人信息 */
.manager-info {
  margin-bottom: 20rpx;
}

.manager-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.manager-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.primary-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #07c160;
  color: white;
  font-size: 22rpx;
  border-radius: 8rpx;
  font-weight: normal;
}

.disabled-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #999;
  color: white;
  font-size: 22rpx;
  border-radius: 8rpx;
  font-weight: normal;
}

.manager-phone {
  font-size: 28rpx;
  color: #666;
}

.notify-level {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.notify-level .label {
  color: #999;
}

.notify-level .value {
  color: #333;
  font-weight: 500;
}

.notify-level .level-desc {
  color: #999;
  font-size: 24rpx;
}

.bind-time {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.manager-actions {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.manager-actions button {
  flex: 1;
  font-size: 26rpx;
}

.btn-edit {
  background: white;
  color: #576b95;
  border: 1rpx solid #576b95;
}

.btn-toggle {
  background: white;
  color: #ff9500;
  border: 1rpx solid #ff9500;
}

.btn-delete {
  background: white;
  color: #fa5151;
  border: 1rpx solid #fa5151;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin: 20rpx 0 10rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #ccc;
}

/* 底部按钮 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: white;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08);
}

.btn-add {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  border: none;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog {
  width: 85%;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  font-weight: normal;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-value {
  font-size: 32rpx;
  color: #333;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.picker {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #333;
}

.form-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.modal-footer {
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer button {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn-cancel {
  background: white;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.btn-confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
}
