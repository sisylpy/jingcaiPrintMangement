/* pages/refill-device/refill-device.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 设备信息卡片 */
.device-info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.device-info-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.device-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.device-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

/* 汇总统计卡片 */
.summary-card {
  background: white;
  border-radius: 10rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.summary-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.summary-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #1AAD19;
  margin-bottom: 5rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #666;
}

/* 日期选择器 */
.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.p-10 {
  padding: 10rpx;
}

.p-20 {
  padding: 20rpx;
}

.pl-10 {
  padding-left: 10rpx;
}

.pr-10 {
  padding-right: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.font-sm {
  font-size: 28rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.border-bottom-shadow {
  border-bottom: 1rpx solid #eee;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* 记录列表 */
.record-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.record-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #1AAD19, #4CAF50);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.refill-type {
  padding: 10rpx 20rpx;
  border-radius: 25rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.refill-type-normal {
  background: linear-gradient(135deg, #1AAD19, #4CAF50);
}

.refill-type-calibrate {
  background: linear-gradient(135deg, #ff9500, #ff6b35);
}

.record-info {
  margin-bottom: 15rpx;
}

.info-row {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.operator-info {
  font-size: 24rpx;
  color: #666;
}

.create-time {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
}

.no-data {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #999;
}

.no-data-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 分页加载 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #666;
}
