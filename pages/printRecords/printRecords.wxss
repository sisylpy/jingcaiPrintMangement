/* pages/printRecords/printRecords.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 设备信息卡片 */
.device-info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.device-info-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.device-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.device-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

/* 按钮样式 */
.btn-success {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
  padding: 6rpx 15rpx;
  border-radius: 12rpx;
}

