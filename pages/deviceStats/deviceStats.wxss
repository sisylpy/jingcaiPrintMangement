/* pages/printStats/printStats.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

/* 日期选择按钮 */
.date-select-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 15rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  border: 1rpx solid #d9d9d9;
}

/* 设备卡片 */
.device-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f0f0;
}

.device-card:active {
  background-color: #fafafa;
}

/* 设备状态 */
.device-status {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.status-normal {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.status-offline {
  background-color: #f5f5f5;
  color: #999;
  border: 1rpx solid #d9d9d9;
}

.status-error {
  background-color: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.status-no-paper {
  background-color: #fff7e6;
  color: #faad14;
  border: 1rpx solid #ffe58f;
}

/* 统计数据行 */
.stats-row {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-value {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #1890ff;
}

/* 纸张状态 */
.paper-bar {
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.paper-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.paper-fill.good {
  background: linear-gradient(90deg, #52c41a, #73d13d);
}

.paper-fill.normal {
  background: linear-gradient(90deg, #1890ff, #40a9ff);
}

.paper-fill.warning {
  background: linear-gradient(90deg, #faad14, #ffc53d);
}

.paper-fill.danger {
  background: linear-gradient(90deg, #ff4d4f, #ff7875);
}

