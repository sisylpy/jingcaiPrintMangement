.entry-page{min-height:100vh;background:#f4f7f5;padding:120rpx 34rpx;box-sizing:border-box}.title{font-size:48rpx;font-weight:800;color:#113c32}.subtitle{color:#78857f;margin:14rpx 0 50rpx}.role-card{display:flex;align-items:center;gap:22rpx;background:#fff;border-radius:24rpx;padding:30rpx;margin:24rpx 0;box-shadow:0 10rpx 28rpx rgba(22,62,49,.08)}.role-card.merchant{border:2rpx solid #0aa47c}.icon{width:84rpx;height:84rpx;border-radius:24rpx;background:#e5f8f1;color:#078565;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:800}.name{font-size:31rpx;font-weight:800;color:#173a32}.desc{font-size:22rpx;color:#7b8782;margin-top:9rpx;line-height:1.5}.arrow{margin-left:auto;font-size:50rpx;color:#9ca5a1}.note{font-size:22rpx;color:#7c8983;background:#eaf3ef;padding:20rpx;border-radius:16rpx;margin-top:40rpx}
