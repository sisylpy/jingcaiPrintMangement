/* pages/recharge-management/recharge-management.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 汇总统计卡片 */
.summary-card {
  background: white;
  border-radius: 10rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.summary-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.summary-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #1AAD19;
  margin-bottom: 5rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #666;
}

/* 日期选择器 */
.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.p-10 {
  padding: 10rpx;
}

.p-20 {
  padding: 20rpx;
}

.pl-10 {
  padding-left: 10rpx;
}

.pr-10 {
  padding-right: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.font-sm {
  font-size: 28rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.border-bottom-shadow {
  border-bottom: 1rpx solid #eee;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* 记录列表 */
.record-card {
  background: white;
  border-radius: 10rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #1AAD19;
}

.points {
  font-size: 28rpx;
  color: #ff9500;
  font-weight: bold;
}

.record-info {
  margin-bottom: 15rpx;
}

.info-row {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.pay-time {
  font-size: 24rpx;
  color: #999;
}

.trade-no {
  font-size: 24rpx;
  color: #666;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
}

.no-data {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #999;
}

.no-data-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 分页加载 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #666;
}
