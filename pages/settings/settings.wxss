/* pages/settings/settings.wxss */

/* 用户头像样式 */
.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

/* 菜单项样式 */
.menu-item {
  padding: 20rpx 0;
}

.menu-item:active {
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.device-icon {
  background-color: #e6f7ff;
}

.user-icon {
  background-color: #f6ffed;
}

.about-icon {
  background-color: #fff7e6;
}

/* 菜单分割线 */
.menu-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 0 -30rpx;
}
