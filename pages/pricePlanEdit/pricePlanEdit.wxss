/* pages/pricePlanEdit/pricePlanEdit.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 20rpx;
}

.form-container {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 表单组 */
.form-group {
  margin-bottom: 40rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4d4f;
}

/* 选择器 */
.picker-container {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.picker-container:active {
  background: #e8f4fd;
  border-color: #1890ff;
}

.picker-text {
  font-size: 32rpx;
  color: #333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 输入框 */
.form-input {
  width: 100%;
  background: #f8f8f8;
  border-radius: 12rpx;
  /* padding: 32rpx 30rpx; */
  font-size: 32rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 90rpx;
  height: 90rpx;
  min-height: 48rpx;
}

.form-input:focus {
  background: #e8f4fd;
  border-color: #1890ff;
}

.form-input::placeholder {
  color: #999;
}

.price-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 图片上传 */
.image-upload-container {
  margin-top: 16rpx;
}

.upload-placeholder {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  transition: all 0.3s ease;
}

.upload-placeholder:active {
  border-color: #1890ff;
  background: #e8f4fd;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.image-preview:active .image-overlay {
  opacity: 1;
}

.overlay-text {
  color: white;
  font-size: 24rpx;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-sizing: border-box;
  min-height: 120rpx;
}

.form-textarea:focus {
  background: #e8f4fd;
  border-color: #1890ff;
}

.form-textarea::placeholder {
  color: #999;
}

/* 单选框 */
.radio-container {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radio-text {
  font-size: 32rpx;
  color: #333;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
}

.btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-cancel:active {
  background: #e8e8e8;
}

.btn-save {
  background: #1890ff;
  color: white;
}

.btn-save.active {
  background: #1890ff;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.btn-save.disabled {
  background: #d9d9d9;
  color: #999;
}

.btn-save.active:active {
  background: #096dd9;
}