.page{min-height:100vh;background:#f3f6f4;padding-bottom:60rpx}.head{background:#113c32;color:#fff;padding:34rpx;display:flex;justify-content:space-between}.name{font-size:36rpx;font-weight:800}.scope{font-size:21rpx;color:#a9c9bf;margin-top:7rpx}.logout{font-size:23rpx}.tabs{display:flex;background:#fff}.tabs view{flex:1;text-align:center;padding:25rpx}.tabs .active{color:#078965;border-bottom:5rpx solid #078965;font-weight:800}.card{margin:20rpx 24rpx;background:#fff;border-radius:20rpx;padding:24rpx}.row{display:flex;justify-content:space-between;align-items:center}.order-no{font-weight:800}.status,.print-status{background:#e6f7ef;color:#0a835f;border-radius:20rpx;padding:6rpx 14rpx;font-size:21rpx}.print-status.FAILED,.print-status.UNKNOWN{background:#fff0eb;color:#c64a33}.meta{font-size:22rpx;color:#85908c;margin-top:12rpx}.bottom{border-top:1rpx solid #edf0ee;margin-top:18rpx;padding-top:18rpx}.amount{font-size:29rpx;font-weight:800;color:#d94738}.empty{text-align:center;padding:100rpx 20rpx;color:#8b9691}.card button{margin-top:20rpx;background:#fff5dd;color:#80601b}.unknown{font-size:21rpx;color:#a34837;background:#fff0eb;padding:14rpx;border-radius:10rpx;margin-top:16rpx}
