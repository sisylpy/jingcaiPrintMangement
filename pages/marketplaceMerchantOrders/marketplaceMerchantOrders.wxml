<view class="page"><view class="head"><view><view class="name">{{session.displayName || '档口工作台'}}</view><view class="scope">仅显示商户 ID {{session.merchantId}} 的订单与打印任务</view></view><view class="logout" bindtap="logout">退出</view></view><view class="tabs"><view class="{{tab==='orders'?'active':''}}" data-tab="orders" bindtap="setTab">履约订单</view><view class="{{tab==='print'?'active':''}}" data-tab="print" bindtap="setTab">打印任务</view></view><view wx:if="{{loading}}" class="empty">加载中…</view><block wx:elif="{{tab==='orders'}}"><view wx:if="{{!orders.length}}" class="empty">本档口暂无居民订单</view><view wx:for="{{orders}}" wx:key="merchantOrderId" class="card" data-id="{{item.merchantOrderId}}" bindtap="openOrder"><view class="row"><view class="order-no">{{item.merchantOrderNo}}</view><view class="status">{{item.statusText}}</view></view><view class="meta">居民总单 {{item.orderNo}}</view><view class="row bottom"><view>{{item.itemCount}} 种商品</view><view class="amount">¥{{item.totalAmount}} ›</view></view></view></block><block wx:else><view wx:if="{{!printTasks.length}}" class="empty">本档口暂无打印任务</view><view wx:for="{{printTasks}}" wx:key="printTaskId" class="card"><view class="row"><view class="order-no">打印任务 #{{item.printTaskId}}</view><view class="print-status {{item.status}}">{{item.statusText}}</view></view><view class="meta">子订单 {{item.merchantOrderId}} · 设备 {{item.deviceCode || '尚未绑定'}}</view><view class="meta">重试 {{item.retryCount}} 次</view><view wx:if="{{item.failureReason}}" class="unknown">{{item.failureReason}}</view><button wx:if="{{item.status==='FAILED'}}" data-id="{{item.printTaskId}}" catchtap="retry">安全重试</button><view wx:if="{{item.status==='UNKNOWN'}}" class="unknown">回执未知：请核实是否已出纸，禁止直接重复打印</view></view></block></view>
