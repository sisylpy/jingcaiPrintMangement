/* pages/refill-management/refill-management.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 汇总统计卡片 */
.summary-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.summary-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.summary-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 30rpx;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-item {
  text-align: center;
  padding: 25rpx 20rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255,255,255,0.2);
}

.summary-number {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

/* 日期选择器 */
.flex-row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.p-10 {
  padding: 10rpx;
}

.p-20 {
  padding: 20rpx;
}

.pl-10 {
  padding-left: 10rpx;
}

.pr-10 {
  padding-right: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.font-sm {
  font-size: 28rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.border-bottom-shadow {
  border-bottom: 1rpx solid #eee;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  background: white;
  border-radius: 0 0 20rpx 20rpx;
}

/* 设备列表 */
.device-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.device-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1AAD19, #4CAF50);
}

.device-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.12);
}

/* 设备头部 */
.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.device-status {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.paper-count {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 设备信息 */
.device-info {
  margin-bottom: 20rpx;
}

.device-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 25rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.last-refill-time {
  font-size: 24rpx;
  color: #666;
}

.tap-hint {
  font-size: 24rpx;
  color: #1AAD19;
  font-weight: 500;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.refill-type {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
}

.refill-type-normal {
  background: #1AAD19;
}

.refill-type-calibrate {
  background: #ff9500;
}

.record-info {
  margin-bottom: 15rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #7f8c8d;
  width: 160rpx;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #2c3e50;
  flex: 1;
  font-weight: 600;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.operator-info {
  font-size: 24rpx;
  color: #666;
}

.create-time {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #666;
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  font-size: 28rpx;
  font-weight: 500;
}

.no-data {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.no-data-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

/* 分页加载 */
.load-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
  font-weight: 500;
}
